    "model.fit(X, y)\n",
    "test_predictions = model.predict(X_test)\n",
    "\n",
    "submission = pd.DataFrame({\n",
    "    \"Id\": df_test[\"Id\"],\n",
    "    \"SalePrice\": test_predictions\n",
    "})\n",
    "\n",
    "submission.to_csv(\"data/submission.csv\", index=False)"
